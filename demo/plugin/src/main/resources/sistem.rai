      "cakisir": [ "nisanci" ], "ultra": true },

    { "id": "olumsuzluk", "ad": "Ölümsüzlük", "duzey": 6, "tur": "zirh", "maks": 1, "taban": 80,
      "ikon": "TOTEM_OF_UNDYING", "aciklama": "Bedenin yıkılmayı reddeder.",
