# RAIDEN SİSTEM — sunucunun kural katmanının TAMAMI.
#
# Tek dosya, tek VM, tek yerel kütüphane. Yeni bir sistem eklemek yeni bir jar
# değil, bu dosyaya yeni bir bölüm demek.
#
# İÇİNDEKİLER
#   1. Ortak yardımcılar
#   2. Ender Sandığı   -> /ec
#   3. Büyü Masası     -> /buyu
#   4. Giriş noktaları (Java buraya çağırıyor)
#
# Java'da olanlar: mc.* ilkelleri. "Ender sandığını aç", "sandık arayüzü aç",
# "şu yuvaya şu eşyayı koy", "PDC'ye şu statı ekle", "XP düş". Tek bir oyun
# kuralı orada yok.
#
# ENTEGRASYON: büyü statları raiden-combatstats'ın okuduğu PDC şemasına
# yazılıyor (raidenrpg:rpg_stat_<stat>, DELTA olarak). Mevcut plugin'lerin tek
# satırı değişmedi.
#
# DÜZENLE VE ÇALIŞTIR: bu dosyayı değiştir, oyunda '/rai yenile' yaz.
# Sunucuyu kapatmaya gerek yok.

include mc


# ############################################################
# #  1. ORTAK
# ############################################################

fn izinli(uuid: str, izin: str) -> bool:
    return mc.izinVar(uuid, izin) == 1

fn anahtarVar(harita, anahtar) -> bool:
    for k in harita.keys():
        if k == anahtar:
            return true
    return false


# ############################################################
# #  2. ENDER SANDIĞI   ->  /ec
# ############################################################
# ============================================================
#  AYARLAR
# ============================================================

BEKLEME = 5.0                              # saniye; 0 yaparsan bekleme kalkar

EC_IZIN_KULLAN     = "raiden.ec.kullan"
IZIN_BASKASI    = "raiden.ec.baskasi"
IZIN_BEKLEMESIZ = "raiden.ec.beklemesiz"

ACILIS_SESI   = "block.ender_chest.open"
RET_SESI      = "block.note_block.bass"
PARCACIK      = "PORTAL"
PARCACIK_ADET = 24

# Başkasının sandığı açıldığında hedefe haber verilsin mi?
HEDEFE_HABER_VER = true


# ============================================================
#  DURUM
# ============================================================

sonKullanim = {}          # uuid -> son açılış zamanı (saniye)
acilisSayisi = 0


# ============================================================
#  YARDIMCILAR
# ============================================================

fn kalanBekleme(uuid: str) -> f64:
    if BEKLEME <= 0.0 or izinli(uuid, IZIN_BEKLEMESIZ):
        return 0.0
    if not anahtarVar(sonKullanim, uuid):
        return 0.0
    gecen = mc.zaman() - sonKullanim[uuid]
    if gecen >= BEKLEME:
        return 0.0
    return BEKLEME - gecen

# Ekranda "2.4 sn" değil "3 sn" görünsün: yukarı yuvarlanmış tam saniye.
fn saniyeYaz(kalan: f64) -> str:
    tam = int(kalan)
    if kalan > tam:
        tam = tam + 1
    return f"{tam}"

fn ret(uuid: str, metin: str):
    mc.mesaj(uuid, f"§c{metin}")
    mc.ses(uuid, RET_SESI, 0.7, 0.8)
    return 0

fn acilisEfekti(uuid: str):
    mc.ses(uuid, ACILIS_SESI, 0.8, 1.0)
    mc.parcacik(uuid, PARCACIK, PARCACIK_ADET)
    return 0


# ============================================================
#  KOMUT
# ============================================================
#
# Java bağlamı ittirmiyor, betik ÇEKİYOR (capi.h deseni): rs_call yalnızca sayı
# taşıdığı için oyuncu kimliği ve argümanlar mc.komut* ile alınıyor.

fn ecKomut():
    uuid = mc.komutOyuncu()
    if uuid == "":
        return 0

    if not izinli(uuid, EC_IZIN_KULLAN):
        return ret(uuid, "Ender sandığını açma yetkin yok.")

    if int(mc.komutArgSayisi()) == 0:
        return kendiSandigi(uuid)
    return baskasininSandigi(uuid, mc.komutArg(0))


fn kendiSandigi(uuid: str):
    kalan = kalanBekleme(uuid)
    if kalan > 0.0:
        return ret(uuid, f"Biraz bekle — {saniyeYaz(kalan)} sn kaldı.")

    if mc.enderAc(uuid, uuid) != 1:
        return ret(uuid, "Sandık açılamadı.")

    sonKullanim[uuid] = mc.zaman()
    outer acilisSayisi = acilisSayisi + 1
    acilisEfekti(uuid)
    mc.mesaj(uuid, "§b§lEnder Sandığı §r§7açıldı.")

    if acilisSayisi % 10 == 0:
        mc.log(f"Ender sandığı {acilisSayisi} kez açıldı.")
    return 0


fn baskasininSandigi(uuid: str, hedefAdi: str):
    if not izinli(uuid, IZIN_BASKASI):
        return ret(uuid, "Başkasının sandığına bakma yetkin yok.")

    hedef = mc.oyuncuBul(hedefAdi)
    if hedef == "":
        return ret(uuid, f"'{hedefAdi}' adında çevrimiçi bir oyuncu yok.")

    if hedef == uuid:
        # Kendi adını yazmak hata değil, sadece uzun yol.
        return kendiSandigi(uuid)

    kalan = kalanBekleme(uuid)
    if kalan > 0.0:
        return ret(uuid, f"Biraz bekle — {saniyeYaz(kalan)} sn kaldı.")

    if mc.enderAc(uuid, hedef) != 1:
        return ret(uuid, "Sandık açılamadı — oyuncu az önce çıkmış olabilir.")

    sonKullanim[uuid] = mc.zaman()
    outer acilisSayisi = acilisSayisi + 1
    acilisEfekti(uuid)

    hedefAd = mc.ad(hedef)
    bakanAd = mc.ad(uuid)
    mc.mesaj(uuid, f"§b§l{hedefAd} §r§7oyuncusunun ender sandığı açıldı.")

    # Gizli gözetleme yok: hedef bilsin. Bu bir kural, ilkel değil — yeri burası.
    if HEDEFE_HABER_VER:
        mc.mesaj(hedef, f"§7{bakanAd} §8ender sandığına baktı.")

    mc.log(f"{bakanAd} -> {hedefAd} ender sandığı")
    return 0


# ============================================================
#  KURULUM
# ============================================================


# ############################################################
# #  3. BÜYÜ MASASI   ->  /buyu
# ############################################################
# ============================================================
#  NADİRLİK MERDİVENİ
# ============================================================
#
# raiden-combatstats/Rarity.java ile BİREBİR aynı sıra ve renk. Sıra bozulursa
# eşya nadirliğiyle büyü nadirliği karşılaştırması yanlış çalışır.

NADIRLIK_ADLARI  = ["Sıradan", "Seyrek", "Nadir", "Epik", "Efsanevi", "Mistik", "Eşsiz"]
NADIRLIK_RENKLER = ["§f",      "§a",     "§9",    "§5",   "§6",       "§d",     "§b"]

# Bir eşyanın kaç büyü taşıyabileceği nadirliğine bağlı: sıradan bir kılıç tek
# büyü alır, Eşsiz olan yedi. Nadirliğin oyun içindeki karşılığı bu.
NADIRLIK_YUVA = [1, 2, 3, 4, 5, 6, 7]

# Nadirliği okunamayan (vanilla) eşyalar için varsayılan.
VARSAYILAN_DUZEY = 1

fn nadirlikDuzeyi(ad: str) -> int:
    i = 0
    while i < len(NADIRLIK_ADLARI):
        if NADIRLIK_ADLARI[i] == ad:
            return i
        i = i + 1
    return -1

# ULTRA büyüler turkuaz. Nadirlik merdiveninin tepesiyle (Eşsiz) aynı renk --
# çünkü ULTRA ayrı bir merdiven değil, o basamağın oyun içindeki adı.
ULTRA_RENK = "§b"
ULTRA_ETIKET = " §b✦ ULTRA"

fn buyuRengi(buyu) -> str:
    if buyu["ultra"]:
        return ULTRA_RENK
    return nadirlikRengi(buyu["duzey"])

# Azami seviyedeki büyü KOYU yazılıyor: aynı renk, kalın. Oyuncu listeye
# bakınca hangisini bitirdiğini okumadan görüyor.
fn koyuMu(buyu, seviye: int) -> str:
    if seviye >= buyu["maks"]:
        return "§l"
    return ""

fn nadirlikRengi(duzey: int) -> str:
    if duzey < 0 or duzey >= len(NADIRLIK_RENKLER):
        return "§7"
    return NADIRLIK_RENKLER[duzey]


# ============================================================
#  BÜYÜLER
# ============================================================
#
# duzey  : büyünün nadirliği (NADIRLIK_ADLARI indeksi)
# tur    : "silah" | "zirh" | "hepsi"
