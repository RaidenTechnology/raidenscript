      "ikon": "ENCHANTED_BOOK", "aciklama": "Zihni genişletir, mana havuzunu büyütür.",
      "etkiler": [ { "stat": "INTELLIGENCE", "deger": 25.0 } ], "cakisir": [], "ultra": false },

