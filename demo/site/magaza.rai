# ============================================================
#  YARDIMCILAR — düğüm kurma
# ============================================================

fn kutu(ust: str, id: str, sinif: str) -> str:
    web.dugum(ust, id, "div", sinif)
    return id

fn yaz(ust: str, id: str, etiket: str, sinif: str, metin: str) -> str:
    web.dugum(ust, id, etiket, sinif)
    web.metin(id, metin)
    return id

fn dugme(ust: str, id: str, sinif: str, metin: str, hedef: str, veri: int) -> str:
    web.dugum(ust, id, "button", sinif)
    web.metin(id, metin)
    web.oznitelik(id, "type", "button")
    web.dinle(id, "tikla", hedef, veri)
    return id


# ============================================================
#  ANİMASYON ÇİZELGELERİ
# ============================================================
#
# Hepsi bir kez bildiriliyor. Bundan sonra betik animasyona dokunmuyor:
# oynatmayı tarayıcı yapıyor. Sınır sadece "oynat" derken geçiliyor.

fn cizelgeleriKur():
    # Aşağıdan yükselerek giriş — kartların ve bölümlerin ortak girişi.
    web.zaman("yukselt")
    web.anahtarKare("yukselt", 0, "opacity", "0")
    web.anahtarKare("yukselt", 0, "transform", "translateY(30px) scale(.985)")
    web.anahtarKare("yukselt", 100, "opacity", "1")
    web.anahtarKare("yukselt", 100, "transform", "translateY(0) scale(1)")

    # Başlık satırları: kendi kutusunun altından kayarak çıkıyor (overflow:hidden).
    web.zaman("satirAc")
    web.anahtarKare("satirAc", 0, "transform", "translateY(108%)")
    web.anahtarKare("satirAc", 100, "transform", "translateY(0)")

    # Hero görseli: hafif büyüyerek ve dönerek yerleşiyor.
    web.zaman("kasaGir")
    web.anahtarKare("kasaGir", 0, "opacity", "0")
    web.anahtarKare("kasaGir", 0, "transform", "rotateY(-30deg) rotateX(14deg) scale(.9)")
    web.anahtarKare("kasaGir", 100, "opacity", "1")
    web.anahtarKare("kasaGir", 100, "transform", "rotateY(-16deg) rotateX(7deg) scale(1)")

    # Sepet rozeti: ürün eklenince zıplıyor.
    web.zaman("pop")
    web.anahtarKare("pop", 0, "transform", "scale(1)")
    web.anahtarKare("pop", 45, "transform", "scale(1.42)")
    web.anahtarKare("pop", 100, "transform", "scale(1)")

    # Kaydırmaya bağlı: hero görseli sayfayla ters yönde süzülüyor (paralaks).
    web.zaman("paralaks")
    web.anahtarKare("paralaks", 0, "transform", "translateY(40px)")
    web.anahtarKare("paralaks", 100, "transform", "translateY(-70px)")

    # Kaydırmaya bağlı: üstteki ilerleme çubuğu.
    web.zaman("ilerle")
    web.anahtarKare("ilerle", 0, "transform", "scaleX(0)")
    web.anahtarKare("ilerle", 100, "transform", "scaleX(1)")

    # Çekmece satırlarının sağdan girişi.
    web.zaman("saganGir")
    web.anahtarKare("saganGir", 0, "opacity", "0")
    web.anahtarKare("saganGir", 0, "transform", "translateX(26px)")
    web.anahtarKare("saganGir", 100, "opacity", "1")
    web.anahtarKare("saganGir", 100, "transform", "translateX(0)")

# Sayı sayan çizelge: her sayaç kendi hedefine gittiği için adı da kendine ait.
# --sayi CSS'te @property ile <integer> olarak kayıtlı, o yüzden ara değerler
# üretilebiliyor; ekrana counter() ile basılıyor.
fn sayacCizelgesi(ad: str, hedef: int):
    web.zaman(ad)
    web.anahtarKare(ad, 0, "--sayi", "0")
    web.anahtarKare(ad, 100, "--sayi", f"{hedef}")


