# RAIDEN PARÇA — mağazanın TAMAMI.
#
# Bu dosyada olanlar: katalog, fiyat biçimleme, indirim, stok, filtre, sıralama,
# sepet matematiği, kargo eşiği, sistem kurucusunun uyumluluk kuralları (soket
# eşleşmesi, güç bütçesi, darboğaz tahmini), sayfanın kurulumu ve HANGİ
# ANİMASYONUN NE ZAMAN OYNAYACAĞI.
#
# JavaScript'te olanlar: düğüm aç, metin yaz, sınıf tak, zaman çizelgesini
# tarayıcıya devret. Tek bir mağaza kuralı orada değil.
#
# ANİMASYON İLKESİ: kare başına stil yazılmıyor. Zaman çizelgesi bir kez
# bildiriliyor, oynatmayı tarayıcı üstleniyor (Web Animations API). Böylece
# animasyon compositor'da koşuyor; betik uzun bir iş yapsa bile kare düşmüyor.

include web


# ============================================================
#  PARA
# ============================================================

RAKAMLAR = "0123456789"

fn binlikAyir(n: int) -> str:
    metin = f"{n}"
    sonuc = ""
    sayac = 0
    i = len(metin) - 1
    while i >= 0:
        if sayac > 0 and sayac % 3 == 0:
            sonuc = "." + sonuc
        sonuc = metin[i] + sonuc
        sayac = sayac + 1
        i = i - 1
    return sonuc

# Kuruş tutulur, ekranda lira gösterilir. Kayan noktalı para yok.
fn paraYaz(kurus: int) -> str:
    kr = kurus % 100
    kurusMetni = f"{kr}" if kr >= 10 else f"0{kr}"
    return f"{binlikAyir(kurus // 100)},{kurusMetni}"

# Türkçe yüzde eki: "%66'sı", "%99'u", "%74'ü". Son rakamın OKUNUŞUNA göre
# değişiyor; tek biçimli bir "'i" eki yanlış yazım üretiyor. Bu da bir metin
# kuralı, yani betiğin işi — CSS bunu yapamaz.
YUZDE_BIR = ["", "'i", "'si", "'ü", "'ü", "'i", "'sı", "'si", "'i", "'u"]
YUZDE_ON  = ["", "'u", "'si", "'u", "'ı", "'si", "'ı", "'i", "'i", "'ı"]

fn yuzdeEki(n: int) -> str:
    if n >= 100:
        return "'ü"
    if n <= 0:
        return "'ı"
    if n % 10 != 0:
        return YUZDE_BIR[n % 10]
    return YUZDE_ON[n // 10]

fn yuzdeYaz(bolum: int, tam: int) -> int:
    if tam <= 0:
        return 0
    return bolum * 100 // tam


