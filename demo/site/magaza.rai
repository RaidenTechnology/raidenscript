# RAIDEN PARTS — the WHOLE store.
#
# What lives here: the catalogue, price formatting, discounts, stock, filtering,
# sorting, cart maths, the free-shipping threshold, the build checker's rules
# (socket match, power budget, bottleneck estimate), the page layout, and WHICH
# ANIMATION PLAYS WHEN.
#
# What lives in JavaScript: open a node, write text, toggle a class, hand a
# timeline to the browser. Not one store rule is over there.
#
# ANİMASYON İLKESİ: kare başına stil yazılmıyor. Zaman çizelgesi bir kez
# bildiriliyor, oynatmayı tarayıcı üstleniyor (Web Animations API). Böylece
# animasyon compositor'da koşuyor; betik uzun bir iş yapsa bile kare düşmüyor.

include web


# ============================================================
#  PARA
# ============================================================

RAKAMLAR = "0123456789"

fn binlikAyir(n: int) -> str:
    metin = f"{n}"
    sonuc = ""
    sayac = 0
    i = len(metin) - 1
    while i >= 0:
        if sayac > 0 and sayac % 3 == 0:
            sonuc = "," + sonuc
        sonuc = metin[i] + sonuc
        sayac = sayac + 1
        i = i - 1
    return sonuc

# Money is kept in cents. No floating point anywhere near a price.
fn paraYaz(kurus: int) -> str:
    kr = kurus % 100
    kurusMetni = f"{kr}" if kr >= 10 else f"0{kr}"
    return f"{binlikAyir(kurus // 100)}.{kurusMetni}"

fn yuzdeYaz(bolum: int, tam: int) -> int:
    if tam <= 0:
        return 0
    return bolum * 100 // tam


