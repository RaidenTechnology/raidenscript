#  HERO
# ============================================================

fn heroKur():
    kutu("", "hero", "hero")
    sol = kutu("hero", "heroSol", "")

    kutu("heroSol", "heroRozet", "hero-rozet")
    kutu("heroRozet", "heroNokta", "nokta")
    yaz("heroRozet", "heroRozetMetin", "span", "", "2026 kataloğu · aynı gün kargo")

    web.dugum("heroSol", "heroBaslik", "h1", "hero-baslik")
    satirlar = ["Parçaları seç,", "sistemi kur,"]
    i = 0
    while i < len(satirlar):
        d = kutu("heroBaslik", f"satir{i}", "satir")
        yaz(d, f"satirIc{i}", "span", "", satirlar[i])
        web.oynat(f"satirIc{i}", "satirAc", 900, "cubic-bezier(.16,1,.3,1)", 120 + i * 110, 1)
        i = i + 1
    d = kutu("heroBaslik", "satir2", "satir")
    yaz(d, "satirIc2", "span", "vurgu", "gücü ölç.")
    web.oynat("satirIc2", "satirAc", 900, "cubic-bezier(.16,1,.3,1)", 340, 1)

    yaz("heroSol", "heroAlt", "p", "hero-alt",
        "Ekran kartından güç kaynağına kadar her bileşen; uyumluluk, güç bütçesi ve darboğaz hesabı sepete eklemeden önce.")
    web.oynat("heroAlt", "yukselt", 760, "cubic-bezier(.16,1,.3,1)", 470, 1)

    kutu("heroSol", "heroDugmeler", "hero-dugmeler")
    dugme("heroDugmeler", "heroDugme1", "dugme dugme-ana", "Kataloğu gez", "katalogaGit", 0)
    dugme("heroDugmeler", "heroDugme2", "dugme dugme-sade", "Sistem kur", "kurucuyaGit", 0)
    web.oynat("heroDugmeler", "yukselt", 760, "cubic-bezier(.16,1,.3,1)", 560, 1)

    # İstatistikler — sayılar sıfırdan hedefe sayıyor.
    kutu("heroSol", "heroIst", "hero-istatistik")
    istAd = ["ürün çeşidi", "marka", "yıl garanti"]
    istDeger = [len(URUNLER), 6, 3]
    i = 0
    while i < len(istAd):
        k = kutu("heroIst", f"ist{i}", "")
        sinif = "ist-deger ist-son" if i == 0 else "ist-deger"
        kutu(k, f"istDeger{i}", sinif)
        yaz(k, f"istAd{i}", "div", "ist-ad", istAd[i])
        sayacCizelgesi(f"sayac{i}", istDeger[i])
        web.oynat(f"istDeger{i}", f"sayac{i}", 1500, "cubic-bezier(.2,.9,.2,1)", 700 + i * 130, 1)
        i = i + 1
    web.oynat("heroIst", "yukselt", 700, "ease-out", 640, 1)

    # Görsel: kasa + iki fan + doluluk şeritleri. Hepsi CSS; betik yerleştiriyor.
    kutu("hero", "heroGorsel", "hero-gorsel")
    kutu("heroGorsel", "kasa", "kasa")
    kutu("kasa", "fan1", "fan fan-1")
    web.stil("fan1", "width", "128px")
    web.stil("fan1", "height", "128px")
    web.stil("fan1", "left", "12%")
    web.stil("fan1", "top", "16%")
    kutu("kasa", "fan2", "fan fan-2")
    web.stil("fan2", "width", "92px")
    web.stil("fan2", "height", "92px")
    web.stil("fan2", "left", "52%")
    web.stil("fan2", "top", "30%")

    kutu("kasa", "seritler", "seritler")
    doluluk = ["0.86", "0.62", "0.41"]
    i = 0
    while i < len(doluluk):
        s = kutu("seritler", f"serit{i}", "serit")
        web.dugum(s, f"seritIc{i}", "i", "")
        web.stil(f"seritIc{i}", "--acik", doluluk[i])
        web.gecis(f"seritIc{i}", "transform", 1400, "cubic-bezier(.2,.9,.2,1)")
        i = i + 1

    web.oynat("kasa", "kasaGir", 1100, "cubic-bezier(.16,1,.3,1)", 260, 1)
    web.kaydirmaBagla("heroGorsel", "paralaks", 0, 100)


# ============================================================
#  ÜRÜN IZGARASI
# ============================================================

fn kategoriSayisi(k: int) -> int:
    if k == 0:
        return len(URUNLER)
    n = 0
    for u in URUNLER:
        if u["kat"] == k:
            n = n + 1
    return n

fn filtrele() -> list:
    liste = []
    i = 0
    while i < len(URUNLER):
        if seciliKategori == 0 or URUNLER[i]["kat"] == seciliKategori:
            liste.push(i)
        i = i + 1
    return sirala(liste)

# Kendi sıralamamız: dilde hazır sort yok, olması da gerekmiyor — ekleme
# sıralaması 20 öğe için fazlasıyla yeterli ve ne yaptığı okunuyor.
fn sirala(liste: list) -> list:
    if seciliSiralama == 0:
        return liste
    sonuc = []
    for i in liste:
        j = 0
        kondu = false
        while j < len(sonuc) and not kondu:
            if oncelikli(i, sonuc[j]):
                sonuc = araya(sonuc, j, i)
                kondu = true
            j = j + 1
        if not kondu:
            sonuc.push(i)
    return sonuc

fn araya(liste: list, yer: int, deger: int) -> list:
    yeni = []
    i = 0
    while i < len(liste):
        if i == yer:
            yeni.push(deger)
        yeni.push(liste[i])
        i = i + 1
    return yeni

fn oncelikli(a: int, b: int) -> bool:
    ua = URUNLER[a]
    ub = URUNLER[b]
    if seciliSiralama == 1:
        return ua["fiyat"] < ub["fiyat"]
    if seciliSiralama == 2:
        return ua["fiyat"] > ub["fiyat"]
    return ua["puan"] > ub["puan"]

fn urunlerKur():
    kutu("", "urunler", "bolum")
    kutu("urunler", "urunBas", "bolum-bas")
    b = kutu("urunBas", "urunBasSol", "")
    yaz(b, "urunEtiket", "div", "bolum-etiket", "Katalog")
    yaz(b, "urunBaslik", "h2", "bolum-baslik", "Bileşenler")
    yaz(b, "urunAlt", "p", "bolum-alt",
        "Filtre, sıralama ve stok durumu betikte hesaplanıyor; sayfa yalnızca sonucu çiziyor.")

    kutu("urunler", "filtre", "filtre")
    i = 0
    while i < len(KATEGORILER):
        id = f"cip{i}"
        sinif = "cip cip-etkin" if i == seciliKategori else "cip"
        dugme("filtre", id, sinif, KATEGORILER[i], "kategoriSec", i)
        yaz(id, f"cipSayi{i}", "span", "cip-sayi", f"{kategoriSayisi(i)}")
        i = i + 1

    s = kutu("filtre", "siralaKutu", "sirala")
    yaz(s, "siralaEtiket", "span", "", "Sırala")
    web.dugum(s, "siralaSecim", "select", "")
    i = 0
    while i < len(SIRALAMALAR):
        o = f"sopt{i}"
        yaz("siralaSecim", o, "option", "", SIRALAMALAR[i])
        web.oznitelik(o, "value", f"{i}")
        i = i + 1
    web.dinle("siralaSecim", "degis", "siralamaDegisti", 0)

    kutu("urunler", "izgara", "izgara")
    izgarayiCiz()

fn izgarayiCiz():
    web.temizle("izgara")
    outer gorunenler = filtrele()
    i = 0
    while i < len(gorunenler):
        kartCiz(gorunenler[i], i)
        i = i + 1

fn kartCiz(u: int, sira: int):
    outer kartSayaci = kartSayaci + 1
    n = kartSayaci
    urun = URUNLER[u]
    id = f"kart{n}"
    kutu("izgara", id, f"kart ton-{urun['ton']}")

    g = kutu(id, f"kg{n}", "kart-gorsel")
    yaz(g, f"ki{n}", "div", "kart-ikon", urun["ikon"])

    if urun["etiket"] != "":
        sinif = "kart-etiket"
        if urun["etiket"] == "İNDİRİM":
            sinif = "kart-etiket etiket-indirim"
        elif urun["etiket"] == "SON 3":
            sinif = "kart-etiket etiket-son"
        yaz(id, f"ke{n}", "div", sinif, urun["etiket"])

    yaz(id, f"km{n}", "div", "kart-marka", urun["marka"])
    # CSS text-transform:uppercase, sayfa lang="tr" olduğu için 'i' harfini 'İ'
    # yapıyor: "Raiden" -> "RAİDEN", "Meridian" -> "MERİDİAN". Marka adları Latin
    # yazımlı; o düğüme lang="en" verilerek Türkçe büyütme kuralı devre dışı.
    web.oznitelik(f"km{n}", "lang", "en")
    yaz(id, f"ka{n}", "div", "kart-ad", urun["ad"])
    yaz(id, f"ko{n}", "div", "kart-ozet", urun["ozet"])

    alt = kutu(id, f"kal{n}", "kart-alt")
    sol = kutu(alt, f"kfk{n}", "")
    fiyatKutusu = kutu(sol, f"kf{n}", "kart-fiyat")
    if urun["eski"] > 0:
        yaz(fiyatKutusu, f"kes{n}", "span", "kart-eski", paraYaz(urun["eski"]))
    yaz(fiyatKutusu, f"kfd{n}", "span", "", paraYaz(urun["fiyat"]))
    yaz(fiyatKutusu, f"kb{n}", "span", "kart-birim", "TL")
    yaz(sol, f"ks{n}", "div", stokSinifi(urun["stok"]), stokMetni(urun["stok"]))

    if urun["stok"] > 0:
        dugme(alt, f"kd{n}", "ekle", "Sepete ekle", "sepeteEkle", u)
    else:
        d = dugme(alt, f"kd{n}", "ekle", "Tükendi", "hicbirSey", 0)
        web.oznitelik(d, "disabled", "1")

    # Kademeli giriş: her kart bir öncekinden 55 ms sonra. 20 kart için tek
    # seferde 20 çağrı; animasyonun kendisi tarayıcıda koşuyor.
    web.oynat(id, "yukselt", 620, "cubic-bezier(.16,1,.3,1)", sira * 55, 1)

fn stokSinifi(stok: int) -> str:
    if stok == 0:
        return "kart-stok stok-yok"
    if stok <= 5:
        return "kart-stok stok-az"
    return "kart-stok"

fn stokMetni(stok: int) -> str:
    if stok == 0:
        return "Stokta yok"
    if stok <= 5:
        return f"Son {stok} adet"
    return f"Stokta {stok} adet"


# ============================================================
#  SİSTEM KURUCU — asıl iş mantığı burada
# ============================================================

fn katUrunleri(k: int) -> list:
    l = []
    i = 0
    while i < len(URUNLER):
        if URUNLER[i]["kat"] == k and URUNLER[i]["stok"] > 0:
            l.push(i)
        i = i + 1
    return l

fn secimKur(ust: str, id: str, etiket: str, k: int):
    a = kutu(ust, f"{id}Alan", "alan")
    yaz(a, f"{id}Etiket", "label", "", etiket)
    web.dugum(a, id, "select", "")
    liste = katUrunleri(k)
    i = 0
    while i < len(liste):
        o = f"{id}o{i}"
        u = URUNLER[liste[i]]
        yaz(id, o, "option", "", f"{u['ad']} — {paraYaz(u['fiyat'])} TL")
        web.oznitelik(o, "value", f"{liste[i]}")
        i = i + 1
    web.dinle(id, "degis", "kurulumGuncelle", 0)

fn kurucuKur():
    kutu("", "kurucu", "bolum")
    kutu("kurucu", "kurucuBas", "bolum-bas")
    b = kutu("kurucuBas", "kurucuBasSol", "")
    yaz(b, "kurucuEtiket", "div", "bolum-etiket", "Sistem kurucu")
    yaz(b, "kurucuBaslik", "h2", "bolum-baslik", "Uyumlu mu, yetiyor mu?")
    yaz(b, "kurucuAlt", "p", "bolum-alt",
        "Soket eşleşmesi, güç bütçesi ve darboğaz tahmini seçim değiştikçe yeniden hesaplanıyor.")

    kutu("kurucu", "kurucuIzgara", "kurucu")
    sol = kutu("kurucuIzgara", "kurucuSol", "panel")
    secimKur(sol, "secIslemci", "İşlemci", 2)
    secimKur(sol, "secAnakart", "Anakart", 5)
    secimKur(sol, "secEkran", "Ekran kartı", 1)
    secimKur(sol, "secGuc", "Güç kaynağı", 6)

    sag = kutu("kurucuIzgara", "kurucuSag", "panel")
    o = kutu(sag, "olcer", "olcer")
    ob = kutu(o, "olcerBas", "olcer-bas")
    yaz(ob, "olcerAd", "span", "", "Güç bütçesi")
    yaz(ob, "olcerDeger", "span", "", "—")
    y = kutu(o, "olcerYol", "olcer-yol")
    kutu(y, "olcerDolu", "olcer-dolu")

    kutu(sag, "uyarilar", "")
    kutu(sag, "ozet", "")

    web.gorununce("kurucu", "bolumGorundu", 18, 2)

# Kuruluma dair her kural burada. JS bu fonksiyonun varlığını bile bilmiyor.
fn kurulumGuncelle(_):
    islemci = URUNLER[int(web.girdi("secIslemci"))]
    anakart = URUNLER[int(web.girdi("secAnakart"))]
    ekran = URUNLER[int(web.girdi("secEkran"))]
    guc = URUNLER[int(web.girdi("secGuc"))]

    # Güç: bileşenler + 90 W taban (disk, fan, bellek, anakart çevresi).
    cekilen = islemci["watt"] + ekran["watt"] + anakart["watt"] + 90
    kapasite = guc["watt"]
    doluluk = yuzdeYaz(cekilen, kapasite)

    web.metin("olcerDeger", f"{cekilen} W / {kapasite} W")
    web.stil("olcerDolu", "width", f"{doluluk if doluluk <= 100 else 100}%")
    web.sinif("olcer", "olcer-tasma", 1 if doluluk > 80 else 0)

    web.temizle("uyarilar")
    sayac = 0

    if islemci["soket"] != anakart["soket"]:
        sayac = uyariEkle(sayac, "hata", f"Soket uyuşmuyor: işlemci {islemci['soket']}, anakart {anakart['soket']}. Bu ikisi aynı kasaya girmez.")
    else:
        sayac = uyariEkle(sayac, "ok", f"Soket eşleşti ({islemci['soket']}).")

    if doluluk > 100:
        sayac = uyariEkle(sayac, "hata", f"Güç kaynağı yetmiyor: {cekilen} W çekilirken {kapasite} W veriliyor.")
    elif doluluk > 80:
        sayac = uyariEkle(sayac, "dikkat", f"Pay dar: kapasitenin %{doluluk}{yuzdeEki(doluluk)} kullanılıyor. Tepe akımlarda kapanma riski var, bir üst modele bakın.")
    else:
        sayac = uyariEkle(sayac, "ok", f"Güç payı rahat: kapasitenin %{doluluk}{yuzdeEki(doluluk)} kullanılıyor.")

    # Darboğaz: iki bileşenin performans puanı arasındaki fark. Kaba ama dürüst
    # bir tahmin — kesin sayı verilmiyor, hangisinin geride kaldığı söyleniyor.
    fark = ekran["puan"] - islemci["puan"]
    if fark > 14:
        sayac = uyariEkle(sayac, "dikkat", f"İşlemci darboğaz olabilir: ekran kartı {fark} puan önde. Yüksek çözünürlükte sorun değil, 1080p'de fark eder.")
    elif fark < -14:
        sayac = uyariEkle(sayac, "dikkat", f"Ekran kartı geride: işlemci {-fark} puan önde. Oyun için daha güçlü bir karta bakılabilir.")
    else:
        sayac = uyariEkle(sayac, "ok", "İşlemci ile ekran kartı dengeli.")

    toplam = islemci["fiyat"] + anakart["fiyat"] + ekran["fiyat"] + guc["fiyat"]
    web.temizle("ozet")
    ozetSatir("ozIslemci", "İşlemci", islemci["fiyat"])
    ozetSatir("ozAnakart", "Anakart", anakart["fiyat"])
    ozetSatir("ozEkran", "Ekran kartı", ekran["fiyat"])
    ozetSatir("ozGuc", "Güç kaynağı", guc["fiyat"])
    t = kutu("ozet", "ozToplam", "ozet-satir ozet-toplam")
    yaz(t, "ozToplamAd", "span", "", "Sistem toplamı")
    yaz(t, "ozToplamDeger", "span", "", f"{paraYaz(toplam)} TL")
    web.oynat("ozToplamDeger", "yukselt", 420, "ease-out", 0, 1)
    return 0

fn uyariEkle(sayac: int, tur: str, metin: str) -> int:
    id = f"uy{sayac}"
    yaz("uyarilar", id, "div", f"uyari uyari-{tur}", metin)
    web.oynat(id, "yukselt", 420, "cubic-bezier(.16,1,.3,1)", sayac * 70, 1)
    return sayac + 1

fn ozetSatir(id: str, ad: str, kurus: int):
    s = kutu("ozet", id, "ozet-satir")
    yaz(s, f"{id}Ad", "span", "ozet-ad", ad)
    yaz(s, f"{id}Deger", "span", "", f"{paraYaz(kurus)} TL")


# ============================================================
#  SEPET
# ============================================================

fn sepetteYeri(u: int) -> int:
    i = 0
    while i < len(sepet):
        if sepet[i]["u"] == u:
            return i
        i = i + 1
    return -1

# DİKKAT — sınır kuralı: host'tan gelen her sayı DOUBLE olarak geliyor (capi.h).
# Liste indisi tam sayı ister, o yüzden olay girişlerinde daraltma zorunlu.
# Bu yapılmazsa hata sessiz değil (URUNLER[u] açık bir tanı basıyor) ama düğme
# de çalışmıyor — gerçekte böyle yakalandı.
fn sepeteEkle(ham):
    u = int(ham)
    urun = URUNLER[u]
    yer = sepetteYeri(u)
    if yer >= 0:
        if sepet[yer]["adet"] >= urun["stok"]:
            return 0
        sepet[yer]["adet"] = sepet[yer]["adet"] + 1
    else:
        sepet.push({ "u": u, "adet": 1 })
    sepetiCiz()
    web.oynat("sepetSayaci", "pop", 460, "cubic-bezier(.2,.9,.2,1)", 0, 1)
    return 0

fn sepettenCikar(ham):
    u = int(ham)
    yer = sepetteYeri(u)
    if yer < 0:
        return 0
    yeni = []
    i = 0
    while i < len(sepet):
        if i != yer:
            yeni.push(sepet[i])
        i = i + 1
    outer sepet = yeni
    sepetiCiz()
    return 0

fn sepetAdedi() -> int:
    n = 0
    for s in sepet:
        n = n + s["adet"]
    return n

fn sepetAraToplam() -> int:
    t = 0
    for s in sepet:
        t = t + URUNLER[s["u"]]["fiyat"] * s["adet"]
    return t

fn sepetiCiz():
    web.metin("sepetSayaci", f"{sepetAdedi()}")
    web.temizle("cekmeceIc")

    bas = kutu("cekmeceIc", "cekBas", "cekmece-bas")
    yaz(bas, "cekBaslik", "h3", "", "Sepet")
    dugme(bas, "cekKapat", "kapat", "✕", "cekmeceKapat", 0)

    if len(sepet) == 0:
        b = kutu("cekmeceIc", "cekBos", "bos")
        yaz(b, "cekBosIkon", "span", "bos-ikon", "▢")
        yaz(b, "cekBosMetin", "div", "", "Sepetin boş. Kataloğa göz at.")
        return 0

    i = 0
    while i < len(sepet):
        s = sepet[i]
        urun = URUNLER[s["u"]]
        id = f"sat{i}"
        kutu("cekmeceIc", id, "satir")
        yaz(id, f"satIkon{i}", "div", "satir-ikon", urun["ikon"])
        orta = kutu(id, f"satOrta{i}", "")
        yaz(orta, f"satAd{i}", "div", "satir-ad", urun["ad"])
        yaz(orta, f"satAlt{i}", "div", "satir-alt", f"{s['adet']} × {paraYaz(urun['fiyat'])} TL")
        sag = kutu(id, f"satSag{i}", "satir-sag")
        yaz(sag, f"satFiyat{i}", "div", "satir-fiyat", f"{paraYaz(urun['fiyat'] * s['adet'])} TL")
        dugme(sag, f"satCikar{i}", "cikar", "kaldır", "sepettenCikar", s["u"])
        web.oynat(id, "saganGir", 420, "cubic-bezier(.16,1,.3,1)", i * 45, 1)
        i = i + 1

    ara = sepetAraToplam()
    kargo = 0 if ara >= KARGO_ESIGI else KARGO_UCRETI

    yaz("cekmeceIc", "cekKargo", "div", "kargo", kargoMetni(ara))
    y = kutu("cekmeceIc", "cekYol", "olcer-yol")
    kutu(y, "cekDolu", "olcer-dolu")
    web.gecis("cekDolu", "width", 900, "cubic-bezier(.2,.9,.2,1)")
    oran = yuzdeYaz(ara, KARGO_ESIGI)
    web.stil("cekDolu", "width", f"{oran if oran <= 100 else 100}%")

    kutu("cekmeceIc", "cekOzet", "")
    ozetSatirCek("cekAra", "Ara toplam", f"{paraYaz(ara)} TL")
    ozetSatirCek("cekKdv", "KDV dahil (%20)", f"{paraYaz(ara * 20 // 120)} TL")
    ozetSatirCek("cekKrg", "Kargo", "Ücretsiz" if kargo == 0 else f"{paraYaz(kargo)} TL")
    t = kutu("cekOzet", "cekTop", "ozet-satir ozet-toplam")
    yaz(t, "cekTopAd", "span", "", "Toplam")
    yaz(t, "cekTopDeger", "span", "", f"{paraYaz(ara + kargo)} TL")

    dugme("cekmeceIc", "cekOde", "dugme dugme-ana", "Ödemeye geç", "odemeyeGec", 0)
    web.stil("cekOde", "width", "100%")
    web.stil("cekOde", "margin-top", "18px")
    return 0

fn ozetSatirCek(id: str, ad: str, deger: str):
    s = kutu("cekOzet", id, "ozet-satir")
    yaz(s, f"{id}Ad", "span", "ozet-ad", ad)
    yaz(s, f"{id}Deger", "span", "", deger)

fn kargoMetni(ara: int) -> str:
    if ara >= KARGO_ESIGI:
        return "Kargo bedava — eşiği geçtin."
    return f"Ücretsiz kargoya {paraYaz(KARGO_ESIGI - ara)} TL kaldı."


