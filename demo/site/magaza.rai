fn kategoriSec(i: int):
    if i == seciliKategori:
        return 0
    web.sinif(f"cip{seciliKategori}", "cip-etkin", 0)
    outer seciliKategori = int(i)
    web.sinif(f"cip{seciliKategori}", "cip-etkin", 1)
    izgarayiCiz()
    return 0

fn siralamaDegisti(_):
    outer seciliSiralama = int(web.girdi("siralaSecim"))
    izgarayiCiz()
    return 0

fn cekmeceAc(_):
    outer cekmeceAcik = true
    web.sinif("cekmece", "cekmece-acik", 1)
    web.sinif("perde", "perde-acik", 1)
    return 0

fn cekmeceKapat(_):
    outer cekmeceAcik = false
    web.sinif("cekmece", "cekmece-acik", 0)
    web.sinif("perde", "perde-acik", 0)
    return 0

fn odemeyeGec(_):
    # Demo: ödeme yok. Gerçek mağazada burada sipariş oluşurdu.
    web.metin("cekOde", f"{sepetAdedi()} ürün · demo, ödeme yok")
    return 0

