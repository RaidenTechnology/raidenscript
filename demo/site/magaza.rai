fn baslat():
    cizelgeleriKur()

    web.metin("markaAd", "RAIDEN PARÇA")
    web.metin("sepetEtiket", "Sepet")

    i = 0
    menuAdlari = ["Katalog", "Sistem kurucu", "Destek"]
    while i < len(menuAdlari):
        yaz("menu", f"menu{i}", "a", "", menuAdlari[i])
        web.oznitelik(f"menu{i}", "href", "#")
        i = i + 1

    web.dinle("sepetDugmesi", "tikla", "cekmeceAc", 0)
    web.dinle("perde", "tikla", "cekmeceKapat", 0)
    web.sayfaBagla("ilerlemeCubugu", "ilerle")

    heroKur()
    urunlerKur()
    kurucuKur()
    altKur()

    kurulumGuncelle(0)
    sepetiCiz()
    return 0

fn altKur():
    kutu("", "alt", "alt")
    yaz("alt", "altNot", "div", "alt-not",
        "Bu sayfanın katalogu, fiyatları, filtresi, sepeti, uyumluluk kuralları ve animasyon zamanlaması RaidenScript ile yazıldı. JavaScript yalnızca düğüm açıyor ve zaman çizelgesini tarayıcıya devrediyor.")
    yaz("alt", "altHak", "div", "", "© 2026 Raiden Technology · demo")
    web.oynat("altNot", "yukselt", 700, "ease-out", 0, 1)
    return 0
