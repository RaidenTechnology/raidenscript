fn baslat():
    cizelgeleriKur()

    web.metin("markaAd", "RAIDEN PARTS")
    web.metin("sepetEtiket", "Cart")

    i = 0
    menuAdlari = ["Catalogue", "Build checker", "Support"]
    while i < len(menuAdlari):
        yaz("menu", f"menu{i}", "a", "", menuAdlari[i])
        web.oznitelik(f"menu{i}", "href", "#")
        i = i + 1

    web.dinle("sepetDugmesi", "tikla", "cekmeceAc", 0)
    web.dinle("perde", "tikla", "cekmeceKapat", 0)
    web.sayfaBagla("ilerlemeCubugu", "ilerle")

    heroKur()
    urunlerKur()
    kurucuKur()
    altKur()

    kurulumGuncelle(0)
    sepetiCiz()
    return 0

fn altKur():
    kutu("", "alt", "alt")
    yaz("alt", "altNot", "div", "alt-not",
        "The catalogue, prices, filtering, cart, compatibility rules and animation timings on this page are written in RaidenScript. JavaScript only opens nodes and hands timelines to the browser.")
    yaz("alt", "altHak", "div", "", "© 2026 Raiden Technology · demo")
    web.oynat("altNot", "yukselt", 700, "ease-out", 0, 1)
    return 0
